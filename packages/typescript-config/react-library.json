{
    "$schema": "https://json.schemastore.org/tsconfig",
    "display": "React Library",
    "extends": "./base.json",
    "compilerOptions": {
        "target": "ES2015",
        "lib": [
            "ES2015",
            "dom"
        ],
        "jsx": "react-jsx",
        "module": "ESNext",
        "declaration": true,
        "declarationMap": true,
        "outDir": "./dist"
    }
}