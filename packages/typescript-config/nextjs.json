{
    "$schema": "https://json.schemastore.org/tsconfig",
    "display": "Next.js",
    "extends": "./base.json",
    "compilerOptions": {
        "target": "ES2017",
        "lib": [
            "dom",
            "dom.iterable",
            "esnext"
        ],
        "allowJs": true,
        "jsx": "preserve",
        "module": "esnext",
        "noEmit": true,
        "incremental": true,
        "resolveJsonModule": true,
        "plugins": [
            {
                "name": "next"
            }
        ]
    },
    "include": [
        "src"
    ],
    "exclude": [
        "node_modules"
    ]
}